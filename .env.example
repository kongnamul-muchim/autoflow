# AutoFlow 환경변수 예시. 실제 값은 .env 에 두고 커밋하지 않는다.

# ── AI (변수 4개면 끝) ────────────────────────────────────
# 프로바이더마다 키 이름을 따로 외울 필요가 없다. 아래 4개만 채운다.
#   AI_PROVIDER : gemini | deepseek | anthropic | openai | openrouter | groq | ollama
#   AI_API_KEY  : 그 제공자의 키
#   AI_MODEL    : 비우면 프리셋 기본 모델
#   AI_BASE_URL : 게이트웨이/프록시를 쓸 때만 (비우면 프리셋 주소)
#
# AI_API_KEY 가 비어 있으면 샘플 응답 모드로 동작한다(과금 없음).
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# 예) DeepSeek
# AI_PROVIDER=deepseek
# AI_API_KEY=sk-...
# AI_MODEL=deepseek-chat
#
# 예) 사내 게이트웨이
# AI_PROVIDER=openai
# AI_API_KEY=...
# AI_BASE_URL=https://gw.example.com/v1

# 예전 변수명(ANTHROPIC_API_KEY, DEEPSEEK_API_KEY, DEEPSEEK_API_BASE ...)도 계속 읽는다.
# 다만 선언한 프로바이더와 실제 주소가 다르면 기동 로그와 /api/health 에 경고가 남는다.

# ── 서버 ─────────────────────────────────────────────────
AUTOFLOW_MODULE=commerce
AUTOFLOW_PORT=4002
LOG_LEVEL=info
