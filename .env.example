# AutoFlow 환경변수 예시. 실제 값은 .env 에 두고 커밋하지 않는다.

# ── AI 프로바이더 (선택) ───────────────────────────────────
# 비워두면 샘플 응답 모드로 동작한다. 값을 넣고 재시작하면 실제 응답으로 전환된다.
# 코드는 수정하지 않는다.
AI_PROVIDER=anthropic

# AI_PROVIDER=anthropic  → 아래 ANTHROPIC_* 사용
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
AUTOFLOW_MODEL=

# AI_PROVIDER=deepseek   → OpenAI 호환 엔드포인트 (DeepSeek·Gemini·vLLM 등)
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=
DEEPSEEK_MODEL=

# AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# ── 서버 ─────────────────────────────────────────────────
AUTOFLOW_MODULE=commerce
AUTOFLOW_PORT=4002
LOG_LEVEL=info
