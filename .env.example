# AutoFlow 환경변수 예시. 실제 값은 .env 에 두고 커밋하지 않는다.

# ── AI (선택) ─────────────────────────────────────────────
# 비워두면 샘플 응답 모드로 동작한다. 값을 넣고 재시작하면 실제 Claude 응답으로 전환된다.
# 코드는 수정하지 않는다.
ANTHROPIC_API_KEY=

# 프록시/게이트웨이를 쓸 때만 지정. 기본값 https://api.anthropic.com
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# 사용할 모델. 기본값은 코드에 있는 claude-sonnet-4-20250514
# AUTOFLOW_MODEL=claude-sonnet-4-20250514

# ── 모듈 ──────────────────────────────────────────────────
# commerce(이커머스) | office(사무자동화). 모듈마다 포트를 다르게 준다.
AUTOFLOW_MODULE=commerce
AUTOFLOW_PORT=4002

# ── 외부 연동 (선택) ──────────────────────────────────────
CAFE24_API_KEY=
